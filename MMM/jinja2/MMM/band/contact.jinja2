{% extends 'MMM/band/base.jinja2' %}
{% block title %}Contact &ndash; Painted Pillars{% endblock %}

{% block content %}
<main class="bandContent">
    <h1 class="bandPageTitle">Contact</h1>
    <p class="bandContactIntro">Want to book us, ask us something or just say hi? Reach us through our channels:</p>
    <ul class="bandContactLinks">
        {% for label, contactUrl in contactLinks %}
        <li class="bandContactLink"><a href="{{ contactUrl }}" target="_blank" rel="noopener">{{ label }}</a></li>
        {% endfor %}
    </ul>
    {% if user.is_authenticated %}
    <p class="bandContactFormIntro">Or mail us right from here: your message reaches the band, with a copy sent to your own email address ({{ user.email }}).</p>
    {% if contactFormSent %}<p class="bandContactFeedback">Thanks! Your message has been mailed to the band and a copy was sent to {{ user.email }}.</p>{% endif %}
    {% if contactFormError %}<p class="bandContactError">{{ contactFormError }}</p>{% endif %}
    <form class="bandContactForm" method="post" action="{{ url('band_contact') }}">
        {{ csrf_input }}
        <label class="bandContactLabel" for="contactSubject">Subject</label>
        <input class="bandContactInput" id="contactSubject" type="text" name="subject" value="{{ contactSubject }}" required>
        <label class="bandContactLabel" for="contactMessage">Message</label>
        <textarea class="bandContactMessage" id="contactMessage" name="message" required>{{ contactMessage }}</textarea>
        <button class="bandContactSubmit" type="submit">Send</button>
    </form>
    {% else %}
    <p class="bandContactLogin">Got a Painted Pillars account? <a href="{{ url('account_login') }}">Sign in</a></p>
    {% endif %}
</main>
{% endblock %}
