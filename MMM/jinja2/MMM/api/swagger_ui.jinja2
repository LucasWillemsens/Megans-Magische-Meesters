{% extends 'base.jinja2' %}

{% block title %}MMM game-action API docs{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="{{ static('swagger-ui/swagger-ui.css') }}">
<link rel="stylesheet" href="{{ static('apiDocs.css') }}">
{% endblock %}

{% block content %}
<div class="serviceDocs">
    <h1 class="serviceDocsTitle">Game action API</h1>
    <p class="serviceDocsIntro">
        Demo API for the current board actions (staged plays, draw, end turn) and resetgames.
        The endpoints described below run the same game services as the browser board, so
        turn limits and the deferred enemy phase behave exactly like the played game.
        Machine readable schema: <a class="serviceDocsSchemaLink" href="{{ schemaUrl }}">{{ schemaUrl }}</a>
    </p>
</div>
<div id="openApiDocs" class="swaggerDocs"></div>
<script src="{{ static('swagger-ui/swagger-ui-bundle.js') }}"></script>
<script>
    window.addEventListener('load', () => {
        window.SwaggerUIBundle({
            url: "{{ schemaUrl }}",
            dom_id: "#openApiDocs",
            withCredentials: false,
            tryItOutEnabled: true,
            docExpansion: "list",
            defaultModelsExpandDepth: 1,
        });
    });
</script>
{% endblock %}
