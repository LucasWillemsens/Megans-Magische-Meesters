{% extends 'base.jinja2' %}

{% block content %}
<div class="title">
    <h1>{{ game.title }} result</h1>
    {% if lastParticipants %}
        <p> {{ result }}: 
        {% for lastParticipant in lastParticipants %}
            {{ lastParticipants[0].player.name }}
            {% if not loop.last %}
            ,
            {% endif%}
        {% endfor %}
        </p>
    {% else %}
    <p>The game ended in a draw.</p>
    {% endif %}
</div>

<div class="cards">
    <div class="cardsText">
        <h2>Participants</h2>
    </div>
    <ul class="basic-mat">
        {% for participant in participants %}
        <li>
            {% if lastParticipants and participant in lastParticipants %}
            <b>{{ participant.player.name }}</b>
            {% else %}
            {{ participant.player.name }}
            {% endif %}
        </li>
        {% endfor %}
    </ul>
</div>

<div class="createButton">
    <a href="{{ playAgainUrl }}" draggable="false">Play again</a>
</div>

<a href="{{ returnURL }}" draggable="false">back</a>
{% endblock %}

