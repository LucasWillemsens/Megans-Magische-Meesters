{% extends 'demo_shell.jinja2' %}

{% block content %}
<div class="playerScreen playingCards rotateHand{% if cardZoomEnabled %} zoomCards{% endif %}" data-shortcut-hold-ms="{{ shortcutHoldMs }}">
    <div class="players">
        <div class="title">
            <h1>{{ game.title }}</h1>
            <p>Round {{ game.roundNumber }}</p>
        </div>
    </div>

    {% if pendingSpecial %}
    <div class="specialPending" data-participant-id="{{ pendingSpecial.id }}">
        <p>{{ pendingSpecial.player.name | possessive }} special is waiting for your input.</p>
        <form method="post" action="{{ actionUrl }}" class="cardActionForm">
            {{ csrf_input }}
            <input type="hidden" name="action" value="continue_special">
            <button type="submit" class="continue-special" title="Continue the special">
                Continue
            </button>
        </form>
    </div>
    {% endif %}

    {% if enemyBoards %}
    <ul class="enemyBoards basic-mat table">
        {% for enemy in enemyBoards %}
        <li class="enemyBoard" data-participant-id="{{ enemy.participant.id }}">
            <div class="enemyDeckHand">
                <p class="cardType debug-overlay">Deck: {{ enemy.deckCount }} | Hand: {{ enemy.handCount }}</p>
                <div class="deck-stack enemy-deck-stack" {% if enemy.deckIndicators %}
                    style="--deck-indicator-count: {{ enemy.deckIndicators|length }};" {% endif %}>
                    {% for indicator in enemy.deckIndicators %}
                    <ul class="deck-indicator" aria-hidden="true" inert
                        style="--deck-indicator-offset: -{{ loop.index * 6.5 }}em;">
                        <li aria-hidden="true" style="--deck-indicator-offset: -{{ loop.index * 6.5 }}em;">
                            <img class="deck-indicator-face" draggable="false" src="/static/extradeck.png"
                                alt="extra pile of cards from deck">
                        </li>
                    </ul>
                    {% endfor %}
                    <ul class="deck enemyDeck active-deck">
                        {% if enemy.deckStack %}
                        {% for card in enemy.deckStack %}
                        <li class="cardContainer faceDown">
                            <div class="card back smallCard"></div>
                        </li>
                        {% endfor %}
                        {% else %}
                        <li>
                            <div class="card back emptyDeck">Empty</div>
                        </li>
                        {% endif %}
                    </ul>
                </div>
                <ul class="hand enemyHand">
                    {% for card in enemy.handCards %}
                    <li class="cardContainer faceDown {{ card.cssClass }}" data-source-lane="{{ card.state.lane }}"
                        data-source-ordinal="{{ card.state.laneOrdinal }}">
                        <div class="card back smallCard"></div>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            <ul class="lanes">
                {% for lane in enemy.laneRows %}
                <li class="lane {{lane.name}}">
                    <ul class="cardRow" title="cards">
                        {% for card in lane.cards %}
                        {% if card.state.faceDown %}
                        <li class="cardContainer {{ card.cssClass }} faceDown" data-source-lane="{{ card.state.lane }}"
                            data-source-ordinal="{{ card.state.laneOrdinal }}">
                            <div class="card back smallCard">
                            </div>
                        </li>
                        {% else %}
                        <li class="cardContainer {{ card.cssClass }}" data-source-lane="{{ card.state.lane }}"
                            data-card-id="{{ card.id }}"
                            title="{{ card.card.title }} of {{ enemy.participant.player.name }}"
                            data-source-ordinal="{{ card.state.laneOrdinal }}">
                            <div class="card smallCard {% if card.card.artSource == "static" %} staticCard {{ card.card|playing_card_rank_class }}
                                {{ card.card|playing_card_suit_class }}{% endif %}">
                                {% if card.card.artSource == "static" %}
                                <span class="rank">{{ card.card|playing_card_rank_display }}</span>
                                <span class="suit">{{ card.card|playing_card_suit_display }}</span>
                                {% else %}
                                {% if card.card.artSource == "" %}
                                <img draggable="false" class="fit-picture" src="{{ static(assestsDir ~ '1flubeltje.jpg')}}" alt="no art of {{card.card.title}}" />
                                {% else %}
                                <img draggable="false" class="fit-picture" src="{{ static(card.card.artSource)}}" alt="art of {{card.card.title}}" />
                                {% endif %}
                                {% endif %}
                                
                                <div class="smallCardInfo">
                                    {% if card.card.artSource != "static" %}
                                    <p>
                                        {{ card.card.title }}
                                    </p>
                                    {% endif %}
                                    <p class="cardType">
                                        {{["Intelligence","Speed","Visciousness","Resolve"][card.card.cardType]}}
                                    </p>
                                </div>
                                </div>
                                </li>
                                {% endif %}
                        {% endfor %}
                    </ul>
                    <p class="debug-overlay"> {{ lane.value }} | {{ lane.name}} </p>
                    <ul class="cardRow" title="trustedCards">
                        {% for card in lane.trustedCards %}
                        <li class="cardContainer trustedCard {{ card.cssClass }}" data-card-id="{{ card.id }}"
                            title="{{ card.card.title }} of {{ enemy.participant.player.name }}">
                            <div class="card smallCard{% if card.card.artSource == "static" %} staticCard {{ card.card|playing_card_rank_class }}
                                {{ card.card|playing_card_suit_class }}{% endif %}">
                                {% if card.card.artSource == "static" %}
                                <span class="rank">{{ card.card|playing_card_rank_display }}</span>
                                <span class="suit">{{ card.card|playing_card_suit_display }}</span>
                                {% else %}
                                {% if card.card.artSource == "" %}
                                <img draggable="false" class="fit-picture" src="{{ static(assestsDir ~ '1flubeltje.jpg')}}" alt="no art of {{card.card.title}}" />
                                {% else %}
                                <img draggable="false" class="fit-picture" src="{{ static(card.card.artSource)}}" alt="art of {{card.card.title}}" />
                                {% endif %}
                                {% endif %}
                                
                                <div class="smallCardInfo">
                                    {% if card.card.artSource != "static" %}
                                    <p>{{ card.card.title }}</p>
                                    {% endif %}
                                    <p class="cardType">
                                        {{["Intelligence","Speed","Visciousness","Resolve"][card.card.cardType]}}
                                    </p>
                                </div>
                                </div>
                                </li>
                        {% endfor %}
                    </ul>
                </li>
                {% endfor %}
            </ul>
            <h2>{{ enemy.participant.player.name }} </h2>
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <p>No enemy participants loaded yet.
    </p>
    {% endif %}

    <ul class="basic-mat table">
        <li class="playerBoard " id="playerBoard" data-participant-id="{{ current_participant.id }}">
            {% set draw_blocked = turnAllowances.draws_left <= 0 or draw_blocked_reason != "" %}
            <div class="deck-stack own-deck-stack" {% if ownDeckIndicators %}
                style="--deck-indicator-count: {{ ownDeckIndicators|length }};" {% endif %}>
                {% for indicator in ownDeckIndicators %}
                <ul class="deck-indicator" aria-hidden="true" inert style="--deck-indicator-offset: -{{ loop.index * 6.5 }}em;">
                    <li aria-hidden="true" style="--deck-indicator-offset: -{{ loop.index * 6.5 }}em;">
                        <img class="deck-indicator-face" draggable="false" src="/static/extradeck.png"
                            alt="extra pile of cards from deck">
                    </li>
                </ul>
                {% endfor %}
                <ul class="deck{% if draw_blocked %} blocked{% endif %} active-deck">
                    {% if ownDeckCount > 0 %}
                    {% for _ in ownDeckStack %}
                    <li>
                        {% if loop.last %}
                        <form method="post" action="{{ actionUrl }}" class="cardActionForm">
                            {{ csrf_input }}
                            <input type="hidden" name="action" value="draw">
                            <button type="submit" class="card back draw{% if draw_blocked %} blocked{% endif %}" {% if
                                draw_blocked %}disabled title="{{ draw_blocked_reason if draw_blocked_reason else
                                turnAllowances.blocked_titles.draw }}"{% else %}title="Draw card"{% endif %}>Draw</button>
                        </form>
                        {% else %}
                        <div class="card back">*</div>
                        {% endif %}
                    </li>
                    {% endfor %}
                    {% else %}
                    <li>
                        <div class="card back emptyDeck">
                            Empty
                        </div>
                    </li>
                    {% endif %}
                </ul>
            </div>
            <h2> {{ player.name }} </h2>
            <ul class="lanes">
                {% for lane in ownLaneRows %}
                <li class="lane {{lane.name}}">
                    <ul class="hologramRow"></ul>
                    <ul class="cardRow" title="cards">
                        {% for card in lane.cards %}
                        {% set card_rotation = ((card.id * 7 + 13) % 9) - 4 %}
                        {% if card.state.faceDown %}
                        <li class="cardContainer faceDown {{ card.cssClass }}{% if turnAllowances.flips_left <= 0 %} blocked{% endif %}"
                            tabindex="0" data-source-lane="{{ card.state.lane }}" data-source-ordinal="{{ card.state.laneOrdinal }}" {% if
                            turnAllowances.flips_left <=0 %} title="{{ turnAllowances.blocked_titles.flip }}" {% endif %}
                            style="--card-rotation: {{ card_rotation }}deg;">
                            <input type="hidden" name="card_id" value="{{ card.id }}">
                            <div class="card back smallCard{% if card.card.artSource == "static" %} staticCard {{ card.card|playing_card_rank_class
                                }} {{ card.card|playing_card_suit_class }}{% endif %}">
                                {% if card.card.artSource == "static" %}
                                <span class="rank">{{ card.card|playing_card_rank_display }}</span>
                                <span class="suit">{{ card.card|playing_card_suit_display }}</span>
                                {% else %}
                                {% if card.card.artSource == "" %}
                                <img draggable="false" class="fit-picture" src="{{ static(assestsDir ~ '1flubeltje.jpg')}}" alt="no art of {{card.card.title}}" />
                                {% else %}
                                <img draggable="false" class="fit-picture" src="{{ static(card.card.artSource)}}" alt="art of {{card.card.title}}" />
                                {% endif %}
                                {% endif %}
                                
                                <div class="smallCardInfo">
                                    {% if card.card.artSource != "static" %}
                                    <p>{{ card.card.title }}</p>
                                    {% endif %}
                                    <p class="cardType">
                                        {{["Intelligence","Speed","Visciousness","Resolve"][card.card.cardType]}}
                                    </p>
                                </div>
                                </div>
                                </li>
                                {% else %}
                                <li class="cardContainer {{ card.cssClass }}" data-source-lane="{{ card.state.lane }}"
                            data-card-id="{{ card.id }}"
                            title="{{ card.card.title }} of {{ player.name }}"
                            data-source-ordinal="{{ card.state.laneOrdinal }}"
                            style="--card-rotation: {{ card_rotation }}deg;">
                            <div class="card smallCard{% if card.card.artSource == "static" %} staticCard {{ card.card|playing_card_rank_class }}
                                {{ card.card|playing_card_suit_class }}{% endif %}">
                                {% if card.card.artSource == "static" %}
                                <span class="rank">{{ card.card|playing_card_rank_display }}</span>
                                <span class="suit">{{ card.card|playing_card_suit_display }}</span>
                                {% else %}
                                {% if card.card.artSource == "" %}
                                <img draggable="false" class="fit-picture" src="{{ static(assestsDir ~ '1flubeltje.jpg')}}" alt="no art of {{card.card.title}}" />
                                {% else %}
                                <img draggable="false" class="fit-picture" src="{{ static(card.card.artSource)}}" alt="art of {{card.card.title}}" />
                                {% endif %}
                                {% endif %}
                                
                                <div class="smallCardInfo">
                                    {% if card.card.artSource != "static" %}
                                    <p>{{ card.card.title }}</p>
                                    {% endif %}
                                    <p class="cardType">
                                        {{["Intelligence","Speed","Visciousness","Resolve"][card.card.cardType]}}
                                    </p>
                                </div>
                                </div>
                                </li>
                                {% endif %}
                        {% endfor %}
                    </ul>
                    <p class="debug-overlay"> {{ lane.value }} | {{ lane.name }} </p>
                    <ul class="cardRow" title="trustedCards">
                        {% for card in lane.trustedCards %}
                        <li class="cardContainer trustedCard {{ card.cssClass }}" data-card-id="{{ card.id }}"
                            title="{{ card.card.title }} of {{ player.name }}">
                            <div class="card smallCard{% if card.card.artSource == "static" %} staticCard {{ card.card|playing_card_rank_class
                                }} {{ card.card|playing_card_suit_class }}{% endif %}">
                                {% if card.card.artSource == "static" %}
                                <span class="rank">{{ card.card|playing_card_rank_display }}</span>
                                <span class="suit">{{ card.card|playing_card_suit_display }}</span>
                                {% else %}
                                {% if card.card.artSource == "" %}
                                <img draggable="false" class="fit-picture" src="{{ static(assestsDir ~ '1flubeltje.jpg')}}" alt="no art of {{card.card.title}}" />
                                {% else %}
                                <img draggable="false" class="fit-picture" src="{{ static(card.card.artSource)}}" alt="art of {{card.card.title}}" />
                                {% endif %}
                                {% endif %}
                                
                                <div class="smallCardInfo">
                                    {% if card.card.artSource != "static" %}
                                    <p>{{ card.card.title }}</p>
                                    {% endif %}
                                    <p class="cardType">
                                        {{["Intelligence","Speed","Visciousness","Resolve"][card.card.cardType]}}
                                    </p>
                                </div>
                                </div>
                                </li>
                        {% endfor %}
                    </ul>
                </li>
                {% endfor %}
            </ul>
        </li>
        <div class="deckHand handContainer">
            <p class="debug-overlay">
                Deck: {{ ownDeckCount }} | Hand: {{ handCards|length }}
                <span id="turnCounters">( {{drawnCardsAmount}}d {{playedCardsAmount}}p {{flippedCardsAmount}}f this turn
                    )</span>
            </p>
            <div class="hand-scroll">
                {% for handFan in handFans %}
                <ul class="hand hand-fan" data-fan-index="{{ loop.index0 }}">
                    {% if handFan %}
                    {% for card in handFan %}
                    <li class="cardContainer {{ card.cssClass }}{% if turnAllowances.plays_left <= 0 %} blocked{% endif %}" {% if
                        turnAllowances.plays_left <=0 %}draggable="false" aria-disabled="true" title="{{ turnAllowances.blocked_titles.play }}" {% else
                        %}draggable="true" tabindex="0" {% endif %} data-card-id="{{ card.id }}" data-source-lane="{{ card.state.lane }}"
                        data-source-ordinal="{{ card.state.laneOrdinal }}">
                        <div class="card smallCard{% if card.card.artSource == "static" %} staticCard {{ card.card|playing_card_rank_class }}
                            {{ card.card|playing_card_suit_class }}{% endif %}">
                            {% if card.card.artSource == "static" %}
                            <span class="rank">{{ card.card|playing_card_rank_display }}</span>
                            <span class="suit">{{ card.card|playing_card_suit_display }}</span>
                            {% else %}
                            {% if card.card.artSource == "" %}
                            <img draggable="false" class="fit-picture" src="{{ static(assestsDir ~ '1flubeltje.jpg')}}" alt="no art of {{card.card.title}}" />
                            {% else %}
                            <img draggable="false" class="fit-picture" src="{{ static(card.card.artSource)}}" alt="art of {{card.card.title}}" />
                            {% endif %}
                            {% endif %}

                            <div class="smallCardInfo">
                                {% if card.card.artSource != "static" %}
                                <p class="cardTitle">{{ card.card.title }}</p>
                                {% endif %}
                                <p class="cardType">
                                    {{["Intelligence","Speed","Visciousness","Resolve"][card.card.cardType]}}
                                </p>
                                </div>
                                </div>
                        <input type="hidden" name="card_id" value="{{ card.id }}">
                        <input type="hidden" name="lane" value="{{ card.card.cardType + 1 }}">
                        </li>
                    {% endfor %}
                    {% else %}
                    <li>
                        <div class="card back emptyHand">
                        </div>
                    </li>
                    {% endif %}
                    </ul>
                    {% endfor %}
                <form method="post" action="{{ actionUrl }}" class="cardActionForm">
                    {{ csrf_input }}
                    <input type="hidden" name="action" value="end_turn">
                    <input type="hidden" name="focused_hand_card" value="{{ turnAllowances.focused_hand_card }}">
                    {% set end_turn_control_label = "Skip" if turnPhase == "enemy" else "End turn" %}
                    <button type="submit" class="end-turn" title="{{ end_turn_blocked_reason if
                        end_turn_blocked_reason else end_turn_control_label }}" {% if end_turn_blocked_reason
                        %}disabled{% elif turnPhase !="enemy" %}autofocus{% endif %}>
                        <span class="suit">{{ end_turn_control_label }}</span>
                    </button>
                    </form>
            </div>
            {% if error_message != "" %}
            <div class="cards">
                <p><b>Action error:</b> {{ error_message }}</p>
            </div>
            {% endif %}
            </div>
            </ul>
            </div>

{% if turnPhase %}
<div id="turnPhase" data-phase="{{ turnPhase }}" hidden></div>
{% endif %}
<div id="boardNext" data-next-url="{{ nextUrl }}" hidden></div>
{% if timelineSteps %}
<script id="timelineSteps" type="application/json">{{ timelineSteps | tojson | safe }}</script>
{% endif %}
<div id="turnLimits" hidden data-draws-left="{{ turnAllowances.draws_left }}"
    data-plays-left="{{ turnAllowances.plays_left }}" data-flips-left="{{ turnAllowances.flips_left }}"
    data-int-count="{{ turnAllowances.int_count }}" data-spd-count="{{ turnAllowances.spd_count }}"
    data-tactics="{{ turnAllowances.tactics }}" data-drawn="{{ turnAllowances.drawn }}"
    data-played="{{ turnAllowances.played }}" data-flipped="{{ turnAllowances.flipped }}"
    data-focused-hand-card="{{ turnAllowances.focused_hand_card }}"
    data-draw-blocked-title="{{ turnAllowances.blocked_titles.draw }}"
    data-play-blocked-title="{{ turnAllowances.blocked_titles.play }}"
    data-flip-blocked-title="{{ turnAllowances.blocked_titles.flip }}">
</div>
<script type="module" src="{{ static('cardDragDrop.js')}}"></script>
<script type="module" src="{{ static('loadingAnimations.js')}}"></script>
<script type="module" src="{{ static('laneStacking.js')}}"></script>
<script type="module" src="{{ static('hoverCooldown.js')}}"></script>
<script type="module" src="{{ static('cardZoom.js')}}"></script>
<script type="module" src="{{ static('boardScroll.js')}}"></script>
<link rel="stylesheet" type="text/css" href="{{ static('cardDragDrop.css') }}">
<link rel="stylesheet" type="text/css" href="{{ static('cardZoom.css') }}">
{% endblock %}