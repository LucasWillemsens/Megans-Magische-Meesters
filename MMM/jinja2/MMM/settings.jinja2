{% extends 'demo_shell.jinja2' %}

{% block title %}Settings{% endblock %}

{% block demo_content %}
{{ super() }}
<div class="demoSettings">
    <div class="title">
        <h1> Settings </h1>
        <p>
            Demo preferences. They are kept for this session only.
        </p>
    </div>

    <div class="demoSettingsPanel">
        <h2> Card zoom </h2>
        <p>
            Enlarges board cards in-page while hovering them, without an overlay or fullscreen.
            Escape releases a zoomed card.
        </p>
        <p class="demoSettingState" data-card-zoom="{{ 'enabled' if cardZoomEnabled else 'disabled' }}">
            Hover card zoom is {% if cardZoomEnabled %}enabled{% else %}disabled{% endif %}.
        </p>
        <form method="post" class="demoNameForm" action="{{ toggleZoomUrl }}">
            {{ csrf_input }}
            <input type="hidden" name="enable" value="{{ 'false' if cardZoomEnabled else 'true' }}">
            <button type="submit" draggable="false">
                {% if cardZoomEnabled %}Disable hover card zoom{% else %}Enable hover card zoom{% endif %}
            </button>
        </form>
    </div>

    <div class="demoSettingsPanel">
        <h2> Hold duration </h2>
        <p>
            How long the D (draw) and E (end turn) board shortcuts must be held
            down before they fire. Both shortcuts share this one duration, and
            0 ms makes them fire instantly.
        </p>
        <p class="demoSettingState" data-shortcut-hold-ms="{{ shortcutHoldMs }}">
            Shortcut holds fire after {{ shortcutHoldMs }} ms.
        </p>
        <form method="post" class="demoNameForm" action="{{ saveHoldUrl }}">
            {{ csrf_input }}
            <label for="shortcutHoldRange">Hold duration</label>
            <input type="range" id="shortcutHoldRange" name="hold_ms" min="0" max="2000" step="100"
                value="{{ shortcutHoldMs }}" draggable="false">
            <output id="shortcutHoldOutput" for="shortcutHoldRange">{{ shortcutHoldMs }} ms</output>
            <button type="submit" draggable="false">Apply hold duration</button>
        </form>
    </div>

    {% if user.is_authenticated %}
    <div class="demoSettingsPanel">
        <h2> Account </h2>
        <p>
            Signs your account out of Painted Pillars.
        </p>
        <form method="post" class="demoNameForm" action="{{ url('account_logout') }}">
            {{ csrf_input }}
            <button type="submit" draggable="false">Log out</button>
        </form>
    </div>
    {% endif %}
</div>
<script type="module" src="{{ static('demoSettings.js')}}"></script>
{% endblock %}
