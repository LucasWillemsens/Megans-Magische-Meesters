<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{% block title %}Magical Masters{% endblock %}</title>
    <link rel="icon" href="{{ static('favicon.png') }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ static('style.css') }}">
    <link rel="stylesheet" href="{{ static('cards.css') }}">
    {% block extra_head %}{% endblock %}
</head>
<body>
    {% block content %}{% endblock %}
    {% block back_button %}<a class="backlink" href="{{ returnURL|default(url('MMM:titlePage')) }}">back</a>{% endblock %}
    {% block demo_content %}{% endblock %}
</body>
</html>

